# Copy to .env. Docker Compose reads this file; images do not contain it.
DEV_FRONTEND_PORT=5173
DEV_BACKEND_PORT=8000

# Use the same successful workflow tag for both images. There is no mutable latest tag.
IMAGE_PREFIX=ghcr.io/thawshi-srikanth/01-aurax-2026
IMAGE_TAG=sha-REPLACE_WITH_PUBLISHED_COMMIT
PROD_BIND_ADDRESS=0.0.0.0
PROD_HTTP_PORT=80
PROD_HTTPS_PORT=443

# One backend container and one worker per cache volume.
FITS_CACHE_MAX_BYTES=536870912
FITS_CACHE_MAX_FILE_BYTES=134217728
FITS_CACHE_MAX_IDLE_SECONDS=604800
# Same-origin Nginx/Vite requests need no cross-origin browser permission.
CORS_ORIGINS=

# Optional TLS overlay. Existing certificates must be supplied separately.
SERVER_NAME=aurax.example.com
TLS_CERTS_DIR=/etc/letsencrypt
TLS_CERTIFICATE_FILE=/etc/letsencrypt/live/aurax.example.com/fullchain.pem
TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/aurax.example.com/privkey.pem
